# Postgres. Any Postgres 13 or newer; a pooler in transaction mode (Supabase, PgBouncer) works.
DATABASE_URL=postgres://openmemfs:openmemfs@localhost:5432/openmemfs

# Port the built server listens on (Cloud Run and most hosts set it for you; the image uses 8080).
PORT=3000

# Saves by the same author closer than this many seconds fold into one version. 0 keeps every save.
VERSION_WINDOW_SECONDS=300

# Apply pending migrations when the server starts. Set to false to run `bun run migrate` yourself.
MIGRATE_ON_START=true

# Host names /api and /mcp answer to, comma-separated, besides localhost, 127.0.0.1 and [::1].
# Set it to your domain when you deploy; `*` answers to any (not recommended).
ALLOWED_HOSTS=

# Only for `bun test`: a throwaway database the tests empty. Never the one above.
TEST_DATABASE_URL=
